# ----------------------------------------------- #
# Make a copy of this file and rename it to .env  #
#                                                 #
#        Also check out our documentation:        #
#   https://askrella.github.io/whatsapp-chatgpt   #
# ----------------------------------------------- #

# Chat provider. Supported values:
# openai, anthropic, gemini, cerebras, openrouter, deepseek, groq, xai, mistral, ollama, custom
# Aliases: claude (anthropic), google/google-gemini (gemini), grok (xai), local (ollama)
AI_PROVIDER=openai

# Model name. Leave empty to use the provider default.
# Examples: gpt-4o-mini, claude-sonnet-4-5, gemini-2.5-flash, deepseek-chat
AI_MODEL=

# Generic key/base URL overrides. If empty, the provider-specific variable below is used.
AI_API_KEY=
AI_BASE_URL=

# Provider API keys. Set the one matching AI_PROVIDER (and OpenAI for DALL-E/Whisper).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# Multiple OpenAI keys can be comma-separated (used for OpenAI-specific features)
# OPENAI_API_KEYS=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPENAI_GPT_MODEL is still accepted as a fallback for AI_MODEL
# OPENAI_GPT_MODEL=gpt-4o-mini
MAX_MODEL_TOKENS=2000

# GPT pre-prompt, added once at the start of a new conversation
PRE_PROMPT=

# Chat prefixes
PREFIX_ENABLED=true
PREFIX_SKIPPED_FOR_ME=true
GPT_PREFIX=!gpt
DALLE_PREFIX=!dalle
STABLE_DIFFUSION_PREFIX=!sd
LANGCHAIN_PREFIX=!lang
RESET_PREFIX=!reset
AI_CONFIG_PREFIX=!config

# Allow the bot to answer in group chats
GROUPCHATS_ENABLED=false

# OpenAI prompt moderation (requires an OpenAI key)
PROMPT_MODERATION_ENABLED=false
PROMPT_MODERATION_BLACKLISTED_CATEGORIES=["hate", "hate/threatening", "self-harm", "sexual", "sexual/minors", "violence", "violence/graphic"]

# Access control: comma-separated phone numbers
WHITELISTED_PHONE_NUMBERS=
WHITELISTED_ENABLED=false

# HuggingFace token, used by the !sd (Stable Diffusion) command
HUGGINGFACE_API_TOKEN=

# SerpAPI token, used by the !lang (LangChain) command
SERPAPI_API_KEY=

# Voice transcription
# Modes: local, openai, speech-api, whisper-api
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_MODE=local
TRANSCRIPTION_LANGUAGE=
WHISPER_API_KEY=
WHISPER_API_URL=https://transcribe.whisperapi.com
SPEECH_API_URL=https://speech-service.verlekar.com

# Text-to-speech
# Modes: speech-api, aws-polly
TTS_ENABLED=false
TTS_TRANSCRIPTION_RESPONSE_ENABLED=true
TTS_MODE=speech-api

# AWS Polly (only needed for TTS_MODE=aws-polly)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_POLLY_VOICE_ID=Joanna
AWS_POLLY_VOICE_ENGINE=standard

# Where the WhatsApp login session is persisted
SESSION_PATH=./session
